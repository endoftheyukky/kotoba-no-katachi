{
  "name": "concrete-poetry",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p functions && vite build",
    "preview": "vite preview",
    "verify": "node tools/verify/run.mjs",
    "verify:write": "node tools/verify/run.mjs --write",
    "verify:snapshots": "node tools/verify/run.mjs snapshots",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./tests/register.mjs --test tests/*.test.ts",
    "v2:structure": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./tests/register.mjs tools/v2/structure.mjs",
    "v2:scope": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./tests/register.mjs tools/v2/scope.mjs",
    "dev:archive": "npm run build && npx --yes wrangler@4 pages dev dist --port 8788",
    "db:migrate:local": "npx --yes wrangler@4 d1 migrations apply kotoba-no-katachi-archive --local",
    "db:migrate:remote": "npx --yes wrangler@4 d1 migrations apply kotoba-no-katachi-archive --remote",
    "admin:password": "node scripts/admin-password.mjs",
    "admin:local": "node scripts/admin-password.mjs --local"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.0"
  }
}
